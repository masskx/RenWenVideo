# Copy this file to .env for local use. The real .env is gitignored.
# The workbench only reports whether a provider is configured; it never returns key values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://token.stoahayaamhsothy.com/v1
# Doubao / Seedream image generation
HUOSHAN_API_KEY=
HUOSHAN_ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
HUOSHAN_IMAGE_MODEL=doubao-seedream-4-0-250828
HUOSHAN_IMAGE_SIZE=2K
# DashScope / CosyVoice TTS
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longxiu_v3
DASHSCOPE_TTS_RATE=0.94
DASHSCOPE_TTS_PITCH=0.96
DASHSCOPE_TTS_VOLUME=65
DASHSCOPE_TTS_INSTRUCTION=
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MUSIC_MODEL=music-3.0
