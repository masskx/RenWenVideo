# Copy this file to .env for local use. The real .env is gitignored. Never commit real keys.
# Images2 illustrations (scripts/build-explainer.mjs --images)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://token.stoahayaamhsothy.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# Narration (docs/video-craft/配音.md): the MiniMax voice is the default (voice id defaults to MashuaiDouyin01)
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
# The earlier cloned voice on Doubao / Volcano Engine TTS ("tts": {"provider": "doubao"}), kept for older films
# Either an API key, or the app's APP ID + Access Token (app credentials win if both are set).
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
# Cloned voice ids (S_…): Chinese, English, optional high-energy clone selected per scene with "voiceEnv"
DOUBAO_VOICE_ZH=
DOUBAO_VOICE_EN=
DOUBAO_VOICE_ZH_ENERGY=
# Optional: CA bundle for the edge-tts backup voice behind a TLS proxy (cloud container: /root/.ccr/ca-bundle.crt)
TTS_CA_BUNDLE=
