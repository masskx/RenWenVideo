  "captions": [
    {
      "text": "真正的成熟，是敢一个人安静",
      "startMs": 0,
      "endMs": 3189,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "不解释，也不迎合",
      "startMs": 3259,
      "endMs": 5015,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "这不是冷漠",
      "startMs": 5086,
      "endMs": 6449,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "是把心从喧闹里带回来",
      "startMs": 6520,
      "endMs": 9062,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "不必在每个群体证明自己",
      "startMs": 9132,
      "endMs": 11466,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "有些关系走远了",
      "startMs": 11537,
      "endMs": 13154,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "不代表你做错了什么",
      "startMs": 13225,
      "endMs": 14519,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "只是同行到了分岔口",
      "startMs": 14590,
      "endMs": 16923,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "独处让人看见",
      "startMs": 16994,
      "endMs": 18473,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "哪些热闹属于自己",
      "startMs": 18544,
      "endMs": 20300,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "哪些期待只是别人的声音",
      "startMs": 20370,
      "endMs": 22588,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "安静下来",
      "startMs": 22659,
      "endMs": 24138,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "才知道自己想要什么",
      "startMs": 24209,
      "endMs": 26427,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "能与自己相处的人",
      "startMs": 26498,
      "endMs": 28369,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "更懂得珍惜相逢",
      "startMs": 28440,
      "endMs": 30311,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "不怕一个人走",
      "startMs": 30382,
      "endMs": 31399,
      "timestampMs": null,
      "confidence": null
    },
    {
      "text": "就不会随便跟谁走",
      "startMs": 31470,
      "endMs": 33480,
      "timestampMs": null,
      "confidence": null
    }
  ]
