# Rendered outputs: out/<series>/<id>/ keeps only the final cut, cover, captions and manifest.
# Draft / silent renders and QA stills go to out/<series>/<id>/drafts/ and stay local.
out/**
!out/**/
!out/INDEX.md
!out/*/*/*.mp4
!out/*/*/*.srt
!out/*/*/*.json
!out/*/*/*-cover.jpg
out/**/drafts/
out/**/*.partial.mp4

# Local QA screenshots are reproducible and not production artifacts.
qa/
qa-transition/
qa-segmented/

.env
.env.*
!.env.example
public/fonts/*
