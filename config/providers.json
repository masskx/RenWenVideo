{
  "version": 1,
  "providers": {
    "images2": {
      "label": "Images2",
      "type": "image",
      "envKey": "OPENAI_API_KEY",
      "baseUrlEnv": "OPENAI_BASE_URL",
      "defaultBaseUrl": "https://token.stoahayaamhsothy.com/v1",
      "defaultModel": "gpt-image-2",
      "mode": "imagegen-cli",
      "description": "现有 images2 生图链路，适合写实、自然质感静帧"
    },
    "doubao": {
      "label": "豆包 Seedream",
      "type": "image",
      "envKey": "HUOSHAN_API_KEY",
      "endpointEnv": "HUOSHAN_ARK_IMAGE_ENDPOINT",
      "defaultEndpoint": "https://ark.cn-beijing.volces.com/api/v3/images/generations",
      "defaultModel": "doubao-seedream-4-0-250828",
      "defaultSize": "2K",
      "mode": "ark-image-api",
      "description": "火山方舟图片接口，适合批量风格化素材与重绘"
    },
    "dashscope-tts": {
      "label": "百炼 CosyVoice",
      "type": "audio",
      "envKey": "DASHSCOPE_API_KEY",
      "endpointEnv": "DASHSCOPE_TTS_ENDPOINT",
      "defaultEndpoint": "https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer",
      "defaultModel": "cosyvoice-v3-flash",
      "defaultVoice": "longxiu_v3",
      "mode": "dashscope-tts",
      "description": "百炼沉稳叙事型中文旁白，默认 longxiu_v3，自动适配当前 33.48 秒画面时间轴"
    },
    "minimax-music": {
      "label": "MiniMax Music",
      "type": "audio",
      "envKey": "MINIMAX_API_KEY",
      "baseUrlEnv": "MINIMAX_API_BASE",
      "defaultBaseUrl": "https://api.minimaxi.com/v1",
      "defaultModel": "music-3.0",
      "mode": "minimax-music-api",
      "description": "MiniMax 纯音乐生成，独立于旁白混音并自动压低音量"
    },
    "bailian-i2v": {
      "label": "百炼 I2V",
      "type": "video",
      "envKey": "DASHSCOPE_API_KEY",
      "defaultModel": "wan3.0-video-prime / happyhorse-1.1-i2v / wan2.7-r2v-2026-06-12",
      "mode": "dashscope-video-api",
      "description": "百炼免费额度优先的 3 秒图生视频链路，静音生成后统一混入旁白和底乐"
    },
    "gemini-omni-web": {
      "label": "Gemini Omni 图生视频",
      "type": "video",
      "mode": "chrome-session",
      "defaultModel": "Gemini Omni",
      "browser": "Chrome",
      "requiresBrowserSession": true,
      "description": "已验证的 Chrome 登录会话链路；适合将 Images2 静帧转成 9:16 动态片段，下载后导入工作台"
    }
  }
}
