  "scenes": [
    {"id": "hook", "visual": "sa.hook", "step": 0, "pace": "brisk",
      "narration": "一张角色图，变成一整套{a}能直接发的表情包，{b}还是透明底的。{c}这套方法，任何一个生图模型都能用。"},
    {"id": "master", "visual": "sa.master", "step": 1, "pace": "brisk",
      "narration": "第一步，定角色。先只出一张{a}不带字的定稿：{b}正面半身、{c}纯色背景、{d}粗线条平涂，{e}下方留出写字的位置。"},
    {"id": "shrink", "visual": "sa.shrink", "step": 1, "pace": "normal",
      "narration": "选图时{a}缩小看，{b}眼镜和嘴巴糊成一团，{c}就让模型减少细节。"},
    {"id": "ref", "visual": "sa.ref", "step": 2, "pace": "brisk",
      "narration": "第二步，换动作。{a}每次都附上同一张定稿当参考，{b}重复发型、眼镜、衣服这些固定特征，{c}只换最后一句动作。"},
    {"id": "chain", "visual": "sa.chain", "step": 2, "pace": "normal",
      "narration": "别拿上一张新图当参考，{a}偏差会越传越大。{b}哪张跑偏了，{c}只重做那一张。"},
    {"id": "alpha", "visual": "sa.alpha", "step": 3, "pace": "normal",
      "narration": "第三步，做透明底。透明靠的是{a}[Alpha|阿尔法]通道，文件里存着{b}每个像素的透明度。"},
    {"id": "white", "visual": "sa.white", "step": 3, "pace": "brisk",
      "narration": "有的模型能直接输出透明[PNG|P N G]；{a}不支持的，比如这张，{b}说了透明还是给了白底，{c}那就先出纯色底，{d}再去掉背景。"},
    {"id": "fake", "visual": "sa.fake", "step": 3, "pace": "normal",
      "narration": "{a}棋盘格要是画进了图里，{b}那只是普通背景。"},
    {"id": "bgtest", "visual": "sa.bgtest", "step": 4, "pace": "brisk",
      "narration": "第四步，验收。把透明图放到{a}深色、{b}浅色、{c}彩色底上，{d}看有没有白边。"},
    {"id": "punch", "visual": "sa.punch", "step": 4, "pace": "normal",
      "narration": "别一键删掉所有白色，{a}牙齿和眼睛高光{b}会被一起抠穿。"},
    {"id": "quarter", "visual": "sa.quarter", "step": 4, "pace": "normal",
      "narration": "再{a}缩到四分之一大小，{b}字认不出来，{c}就把人缩小、{d}把字放大。"},
    {"id": "text", "visual": "sa.text", "step": 5, "pace": "normal",
      "narration": "每句话{a}六个字以内，{b}粗黑字、{c}位置统一。"},
    {"id": "reuse", "visual": "sa.reuse", "step": 5, "pace": "normal",
      "narration": "做好的透明角色，还能接着用在{a}海报、{b}视频贴图和{c}[PPT|P P T]里。"},
    {"id": "close", "visual": "sa.close", "step": 5, "pace": "normal", "tailMs": 900,
      "narration": "{a}先做四张，{b}发进聊天里试试。"}
  ]
