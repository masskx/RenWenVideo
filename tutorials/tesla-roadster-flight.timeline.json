        "e": 13795
      },
      "captions": [
        {
          "text": "特斯拉真的发布了一台“会飞的车”",
          "startMs": 200,
          "endMs": 2746
        },
        {
          "text": "10 月 15 日",
          "startMs": 2746,
          "endMs": 4644
        },
        {
          "text": "得州一处 SpaceX 测试场",
          "startMs": 4644,
          "endMs": 6830
        },
        {
          "text": "新一代 Roadster 冲上弯道",
          "startMs": 6830,
          "endMs": 8543
        },
        {
          "text": "倒挂在顶上",
          "startMs": 8543,
          "endMs": 9595
        },
        {
          "text": "然后喷气、翻身",
          "startMs": 9595,
          "endMs": 11187
        },
        {
          "text": "落地",
          "startMs": 11187,
          "endMs": 11998
        },
        {
          "text": "可它到底算不算飞行汽车？",
          "startMs": 11998,
          "endMs": 13795
        },
        {
          "text": "我们把演示和承诺分开看",
          "startMs": 13795,
          "endMs": 15691
        }
      ]
    },
    {
      "id": "ramp",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/02-ramp.mp3",
      "audioMs": 10815,
      "startFrame": 484,
      "durationFrames": 342,
      "cues": {
        "a": 1328,
        "b": 2936,
        "c": 6574,
        "d": 9003
      },
      "captions": [
        {
          "text": "先看第一个演示",
          "startMs": 200,
          "endMs": 1328
        },
        {
          "text": "车冲上一段弧形坡道",
          "startMs": 1328,
          "endMs": 2936
        },
        {
          "text": "底部的风扇把车吸在路面上",
          "startMs": 2936,
          "endMs": 4955
        },
        {
          "text": "一直到完全倒挂",
          "startMs": 4955,
          "endMs": 6574
        },
        {
          "text": "然后推进器一推",
          "startMs": 6574,
          "endMs": 7899
        },
        {
          "text": "车离开坡道",
          "startMs": 7899,
          "endMs": 9003
        },
        {
          "text": "空中翻身，四轮落地",
          "startMs": 9003,
          "endMs": 10962
        }
      ]
    },
    {
      "id": "jump",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/03-jump.mp3",
      "audioMs": 14393,
      "startFrame": 826,
      "durationFrames": 449,
      "cues": {
        "a": 2340,
        "b": 4184,
        "c": 8918,
        "d": 11199,
        "e": 12740
      },
      "captions": [
        {
          "text": "第二个演示在行驶中",
          "startMs": 200,
          "endMs": 2340
        },
        {
          "text": "推进器把整台车托起来",
          "startMs": 2340,
          "endMs": 4184
        },
        {
          "text": "从 Cybercab",
          "startMs": 4184,
          "endMs": 5192
        },
        {
          "text": "Cybertruck",
          "startMs": 5192,
          "endMs": 5948
        },
        {
          "text": "Semi、Model Y 和",
          "startMs": 5948,
          "endMs": 7291
        },
        {
          "text": "Model 3 头上越过去",
          "startMs": 7291,
          "endMs": 8918
        },
        {
          "text": "特斯拉管这叫“短时飞行”",
          "startMs": 8918,
          "endMs": 11199
        },
        {
          "text": "另外据报道",
          "startMs": 11199,
          "endMs": 12740
        },
        {
          "text": "演示车是远程遥控的",
          "startMs": 12740,
          "endMs": 14547
        }
      ]
    },
    {
      "id": "gas",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/04-gas.mp3",
      "audioMs": 15020,
      "startFrame": 1275,
      "durationFrames": 468,
      "cues": {
        "a": 1326,
        "b": 3794,
        "c": 4973,
        "d": 8157,
        "e": 11921
      },
      "captions": [
        {
          "text": "推力从哪来？",
          "startMs": 200,
          "endMs": 1326
        },
        {
          "text": "不是螺旋桨",
          "startMs": 1326,
          "endMs": 2710
        },
        {
          "text": "也不是燃烧",
          "startMs": 2710,
          "endMs": 3794
        },
        {
          "text": "是压缩空气",
          "startMs": 3794,
          "endMs": 4973
        },
        {
          "text": "车里能塞的空间",
          "startMs": 4973,
          "endMs": 6275
        },
        {
          "text": "都塞满了碳纤维高压气瓶",
          "startMs": 6275,
          "endMs": 8157
        },
        {
          "text": "一共约 600 升",
          "startMs": 8157,
          "endMs": 9805
        },
        {
          "text": "接着 10 个推进器",
          "startMs": 9805,
          "endMs": 11921
        },
        {
          "text": "气用完了",
          "startMs": 11921,
          "endMs": 12706
        },
        {
          "text": "车上的压缩机还能自己充回去",
          "startMs": 12706,
          "endMs": 15165
        }
      ]
    },
    {
      "id": "speed",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/05-speed.mp3",
      "audioMs": 9561,
      "startFrame": 1743,
      "durationFrames": 304,
      "cues": {
        "a": 1649,
        "b": 5524
      },
      "captions": [
        {
          "text": "第三个演示是加速",
          "startMs": 200,
          "endMs": 1649
        },
        {
          "text": "0 到 60 英里",
          "startMs": 1649,
          "endMs": 3503
        },
        {
          "text": "现场测出 0.81 秒",
          "startMs": 3503,
          "endMs": 5524
        },
        {
          "text": "特斯拉说",
          "startMs": 5524,
          "endMs": 6339
        },
        {
          "text": "推进器的推力是轮胎抓地力的",
          "startMs": 6339,
          "endMs": 8596
        },
        {
          "text": "4 到 5 倍",
          "startMs": 8596,
          "endMs": 9713
        }
      ]
    },
    {
      "id": "trims",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/06-trims.mp3",
      "audioMs": 16483,
      "startFrame": 2047,
      "durationFrames": 512,
      "cues": {
        "a": 1541,
        "b": 4316,
        "c": 8062,
        "d": 11206
      },
      "captions": [
        {
          "text": "订车分三个版本",
          "startMs": 200,
          "endMs": 1541
        },
        {
          "text": "Performance",
          "startMs": 1541,
          "endMs": 2331
        },
        {
          "text": "能上路，订金 5 万美元",
          "startMs": 2331,
          "endMs": 4316
        },
        {
          "text": "Thrust，带后置推进器",
          "startMs": 4316,
          "endMs": 6298
        },
        {
          "text": "订金 25 万美元",
          "startMs": 6298,
          "endMs": 8062
        },
        {
          "text": "Rocket，单座",
          "startMs": 8062,
          "endMs": 9031
        },
        {
          "text": "全套飞行系统",
          "startMs": 9031,
          "endMs": 10162
        },
        {
          "text": "只接受邀请",
          "startMs": 10162,
          "endMs": 11206
        },
        {
          "text": "中国官网也开了预订",
          "startMs": 11206,
          "endMs": 12882
        },
        {
          "text": "只有 Performance",
          "startMs": 12882,
          "endMs": 14286
        },
        {
          "text": "意向金 33.2 万元",
          "startMs": 14286,
          "endMs": 16624
        }
      ]
    },
    {
      "id": "claims",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/07-claims.mp3",
      "audioMs": 7262,
      "startFrame": 2559,
      "durationFrames": 235,
      "cues": {
        "a": 2384,
        "b": 4823,
        "c": 6125
      },
      "captions": [
        {
          "text": "下面这些是承诺",
          "startMs": 200,
          "endMs": 1348
        },
        {
          "text": "现场没有演示",
          "startMs": 1348,
          "endMs": 2384
        },
        {
          "text": "最高时速超过 230 英里",
          "startMs": 2384,
          "endMs": 4823
        },
        {
          "text": "续航 300 英里",
          "startMs": 4823,
          "endMs": 6125
        },
        {
          "text": "2028 年投产",
          "startMs": 6125,
          "endMs": 7412
        }
      ]
    },
    {
      "id": "history",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/08-history.mp3",
      "audioMs": 15386,
      "startFrame": 2794,
      "durationFrames": 479,
      "cues": {
        "a": 1584,
        "b": 3647,
        "c": 5988,
        "d": 7996,
        "e": 8789,
        "f": 9497,
        "g": 11265,
        "h": 13696
      },
      "captions": [
        {
          "text": "为什么要打个问号？",
          "startMs": 200,
          "endMs": 1584
        },
        {
          "text": "这台车 2017 年第一次亮相",
          "startMs": 1584,
          "endMs": 3647
        },
        {
          "text": "当时说 2020 年交付",
          "startMs": 3647,
          "endMs": 5988
        },
        {
          "text": "之后又在 2020",
          "startMs": 5988,
          "endMs": 7996
        },
        {
          "text": "2021、2023",
          "startMs": 7996,
          "endMs": 9497
        },
        {
          "text": "2024 年一次次推迟",
          "startMs": 9497,
          "endMs": 11265
        },
        {
          "text": "订车协议也写着",
          "startMs": 11265,
          "endMs": 12532
        },
        {
          "text": "不保证交付日期",
          "startMs": 12532,
          "endMs": 13696
        },
        {
          "text": "甚至不保证一定交付",
          "startMs": 13696,
          "endMs": 15548
        }
      ]
    },
    {
      "id": "outro",
      "audioSrc": "audio/tutorials/tesla-roadster-flight/09-outro.mp3",
      "audioMs": 16039,
      "startFrame": 3273,
      "durationFrames": 498,
      "cues": {
        "a": 2500,
        "b": 5870,
        "c": 8448,
        "d": 12156
      },
      "captions": [
        {
          "text": "所以它不是在天上开的车",
          "startMs": 200,
          "endMs": 2500
        },
        {
          "text": "而是一台能用压缩空气跳一下",
          "startMs": 2500,
          "endMs": 4543
        },
        {
          "text": "翻个身的超跑",
          "startMs": 4543,
          "endMs": 5870
        },
        {
          "text": "演示是真的",
          "startMs": 5870,
          "endMs": 6948
        },
        {
          "text": "量产是承诺",
          "startMs": 6948,
          "endMs": 8448
        },
        {
          "text": "马斯克自己也说过",
          "startMs": 8448,
          "endMs": 10136
        },
        {
          "text": "安全不是它的首要目标",
          "startMs": 10136,
          "endMs": 12156
        },
        {
          "text": "2028 年见分晓",
          "startMs": 12156,
          "endMs": 13808
        },
        {
          "text": "你会订吗？",
          "startMs": 13808,
          "endMs": 15137
        },
        {
          "text": "评论区聊聊",
          "startMs": 15137,
          "endMs": 16188
        }
      ]
    }
  ]
