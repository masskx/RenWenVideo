 "scenes": [
  {
   "id": "hook",
   "visual": "adr.hook",
   "step": 0,
   "pace": "brisk",
   "narration": "奥特曼说，你电脑里的内存，{a}只有5%的时间在用，{b}相当糟糕。"
  },
  {
   "id": "mean",
   "visual": "adr.mean",
   "step": 0,
   "pace": "brisk",
   "narration": "他的意思是：内存全球都不够，{a}放云端用满，{b}比放在每个人电脑里划算。"
  },
  {
   "id": "check",
   "visual": "adr.check",
   "step": 0,
   "pace": "brisk",
   "narration": "但5%是他随口一估，{a}没给任何依据；{b}他也没说要收走你的内存。"
  },
  {
   "id": "rumor",
   "visual": "adr.rumor",
   "step": 0,
   "pace": "brisk",
   "narration": "网上的「交内存换订阅」，{a}是网友恶搞，{b}已经被辟谣。"
  },
  {
   "id": "wafer",
   "visual": "adr.wafer",
   "step": 0,
   "pace": "brisk",
   "narration": "为什么他会这么说？{a}AI卡上的HBM和你的内存条，{b}抢的是同一批晶圆。"
  },
  {
   "id": "triple",
   "visual": "adr.triple",
   "step": 0,
   "pace": "brisk",
   "narration": "据美光，同样容量，{a}HBM要吃掉约3倍的晶圆。"
  },
  {
   "id": "share",
   "visual": "adr.share",
   "step": 0,
   "pace": "brisk",
   "narration": "TrendForce估计，今年底HBM吃掉22%的晶圆，{a}只产出9%的容量。"
  },
  {
   "id": "price",
   "visual": "adr.price",
   "step": 0,
   "pace": "brisk",
   "narration": "于是内存条涨价：{a}英国亚马逊一款32G内存，{b}13个月涨了434%。"
  },
  {
   "id": "ease",
   "visual": "adr.ease",
   "step": 0,
   "pace": "brisk",
   "narration": "不过涨幅在收敛：{a}四季度合约价，{b}预计再涨10%到15%。"
  },
  {
   "id": "end",
   "visual": "adr.end",
   "step": 0,
   "pace": "brisk",
   "narration": "所以，没人要收走你的内存；{a}但你的内存条，确实在和AI抢晶圆。"
  }
 ],
