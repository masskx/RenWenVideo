 "scenes": [
  {
   "id": "hook",
   "visual": "ns.hook",
   "step": 0,
   "pace": "brisk",
   "narration": "你对手机说“开灯”，{a}灯亮之前，{b}这句话至少要过6种协议。"
  },
  {
   "id": "dns",
   "visual": "ns.dns",
   "step": 0,
   "pace": "brisk",
   "narration": "第一步问路：{a}手机只认得名字，{b}DNS把名字换成一串数字地址。"
  },
  {
   "id": "udp",
   "visual": "ns.udp",
   "step": 0,
   "pace": "brisk",
   "narration": "问路用的是UDP：{a}包扔出去就不管，{b}不握手、不确认，{c}丢了就再问一次。"
  },
  {
   "id": "ip",
   "visual": "ns.ip",
   "step": 0,
   "pace": "brisk",
   "narration": "地址有了，就轮到IP：{a}每个包都贴上地址，{b}路由器一跳一跳往下传。"
  },
  {
   "id": "tcp",
   "visual": "ns.tcp",
   "step": 0,
   "pace": "brisk",
   "narration": "但IP只管送，不管丢没丢。{a}所以要TCP：{b}先握三次手，{c}每个包编号，{d}丢了哪个补哪个。"
  },
  {
   "id": "http",
   "visual": "ns.http",
   "step": 0,
   "pace": "brisk",
   "narration": "路通了，真正的话用HTTP写：{a}一个请求，把灯打开；{b}服务器回一个200，办成了。"
  },
  {
   "id": "mqtt",
   "visual": "ns.mqtt",
   "step": 0,
   "pace": "brisk",
   "narration": "最后一段换MQTT：{a}灯早就订阅了自己的频道，{b}服务器一发布，{c}消息马上推到灯上。"
  },
  {
   "id": "stack",
   "visual": "ns.stack",
   "step": 0,
   "pace": "brisk",
   "narration": "回头看，这句话是一层套一层：{a}HTTP装进TCP，{b}TCP装进IP。"
  },
  {
   "id": "end",
   "visual": "ns.end",
   "step": 0,
   "pace": "brisk",
   "narration": "下次灯没亮，{a}你就知道该问是哪一层了。"
  }
 ]
