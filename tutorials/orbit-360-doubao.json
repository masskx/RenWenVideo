  "scenes": [
    {"id": "hook", "visual": "orb.hook", "step": 1, "pace": "brisk",
      "narration": "一张照片，加一句话，镜头就能绕着它转一整圈。{a}不用装软件，豆包里就能做。"},
    {"id": "what", "visual": "orb.what", "step": 1, "pace": "normal",
      "narration": "这叫{a}360度环绕，也叫子弹时间：{d}画面全部定格，只有{b}镜头在动。AI会根据照片里的空间线索，{c}补出别的角度。"},
    {"id": "uses", "visual": "orb.uses", "step": 2, "pace": "brisk",
      "narration": "能干嘛？{a}旅游美食随拍，多一个角度；{b}美妆，从正面绕到侧面，眼影高光看得清；{c}产品图，瓶身曲面和反光跟着视角变；{d}拍好的模特图、穿搭图，也能再出一条动态素材。"},
    {"id": "step1", "visual": "orb.step1", "step": 3, "pace": "normal",
      "narration": "做法就两步。{a}第一步，打开豆包，{b}上传一张主体清楚的照片。{c}千问、元宝能图生视频，也能试。"},
    {"id": "step2", "visual": "orb.step2", "step": 3, "pace": "normal",
      "narration": "第二步，把指令一起发过去。{e}核心四句：{a}主体和环境定格在原图瞬间；{b}摄影机绕主体走水平圆弧，镜头始终对着主体；{c}高度和距离不变；{d}不切镜、不变焦、不加新东西。"},
    {"id": "pitfalls", "visual": "orb.pitfalls", "step": 4, "pace": "normal",
      "narration": "三个坑。{a}一，主体和背景要有前后层次，视差才明显。{b}二，写清楚是镜头在绕，不是人在转，不然人会自己转身。{c}三，豆包免费额度用完会提示扣付费额度，看到再决定。"},
    {"id": "check", "visual": "orb.check", "step": 4, "pace": "brisk",
      "narration": "生成后检查四点：{a}主体定没定格，{b}镜头真没真绕，{c}侧面背面变没变形，{d}结尾能不能接回开头。"},
    {"id": "advanced", "visual": "orb.advanced", "step": 5, "pace": "normal",
      "narration": "想自己控参数，可以用{a}ComfyUI本地跑，加{b}360度环绕LoRA。{c}但模型几十个G，这个LoRA也主要拿人像训练。{d}新手先用豆包就够了。"},
    {"id": "close", "visual": "orb.close", "step": 5, "pace": "calm", "tailMs": 900,
      "narration": "先拿你手机里最好看的那张照片，试一张。"}
  ]
}
