  {
   "id": "hook",
   "visual": "chip.hook",
   "step": 0,
   "pace": "brisk",
   "narration": "同一个80亿参数的模型，{a}CPU每秒约吐6个字，{b}GPU能到200个。"
  },
  {
   "id": "cpu",
   "visual": "chip.cpu",
   "step": 0,
   "pace": "brisk",
   "narration": "差别在结构：{a}CPU是几个大核，{b}擅长一步步算复杂逻辑。"
  },
  {
   "id": "gpu",
   "visual": "chip.gpu",
   "step": 0,
   "pace": "brisk",
   "narration": "GPU是上万个小核，{a}H100有16896个，{b}一条指令同时算一大片数。"
  },
  {
   "id": "npu",
   "visual": "chip.npu",
   "step": 0,
   "pace": "brisk",
   "narration": "NPU塞在手机和电脑里，{a}只做AI的乘加，{b}微软AI电脑要求每秒40万亿次。"
  },
  {
   "id": "tpu",
   "visual": "chip.tpu",
   "step": 0,
   "pace": "brisk",
   "narration": "TPU是谷歌的AI芯片：{a}乘加器排成128乘128的方阵，{b}数据一拍走一格。"
  },
  {
   "id": "math",
   "visual": "chip.math",
   "step": 0,
   "pace": "brisk",
   "narration": "大模型几乎全是矩阵乘法：{a}每吐一个字，{b}80亿个参数都要算一遍。"
  },
  {
   "id": "move",
   "visual": "chip.move",
   "step": 0,
   "pace": "brisk",
   "narration": "可真正卡住它的是搬数据：{a}每吐一个字，{b}16GB权重都要读一遍。"
  },
  {
   "id": "bus",
   "visual": "chip.bus",
   "step": 0,
   "pace": "brisk",
   "narration": "电脑内存128根线，{a}HBM有5120根，{b}带宽差35倍。"
  },
  {
   "id": "hbm",
   "visual": "chip.hbm",
   "step": 0,
   "pace": "brisk",
   "narration": "线太多，只能叠起来贴着GPU放：{a}据美光，同样容量，{b}HBM吃约3倍晶圆。"
  },
  {
   "id": "price",
   "visual": "chip.price",
   "step": 0,
   "pace": "brisk",
   "narration": "AI把内存抢光，{a}据TrendForce，{b}显存现货价涨了约3倍。"
  },
  {
   "id": "end",
   "visual": "chip.end",
   "step": 0,
   "pace": "brisk",
   "narration": "所以大模型缺的不只是算力，{a}是搬数据的路。"
  }
