    "qa:richness": "node scripts/qa/richness.mjs",
    "qa:scan": "node scripts/qa/scan.mjs",
    "qa:marks": "node scripts/qa/marks.mjs",
    "qa:clutter": "node scripts/qa/clutter.mjs",
    "qa:palette": "node scripts/qa/palette.mjs",
    "prompts:find": "node scripts/prompts/find.mjs",
    "prompts:snapshot": "node scripts/prompts/snapshot.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
